# ==============================================================================
# Homelab TCP Dual-Protocol - Configurações do SERVIDOR
# ==============================================================================
# Este arquivo contém as variáveis exclusivas para a máquina/host do Servidor.

# Endereço IP de escuta (0.0.0.0 escuta em todas as interfaces de rede)
HOMELAB_SERVER_HOST=0.0.0.0

# Porta do Canal de Controle (Persistente, Framing binário de 40B, HMAC dinâmico)
HOMELAB_CONTROL_PORT=9000

# Porta do Canal de Dados/Mídia (Recepção de arquivos em chunks indexados de 64KB)
HOMELAB_DATA_PORT=9001

# Chave secreta inicial para handshake e autenticação prévia (deve coincidir com o cliente)
HOMELAB_HANDSHAKE_KEY=homelab-initial-handshake-key-32

# Tamanho padrão do buffer e chunks de mídia em bytes (padrão: 65536 = 64KB)
HOMELAB_CHUNK_SIZE=65536
HOMELAB_BUFFER_SIZE=4096

# Caminhos de armazenamento no host
HOMELAB_DB_PATH=app/data/homelab.db
HOMELAB_LOG_PATH=app/logs/server_messages.log
HOMELAB_UPLOADS_DIR=app/data/uploads
