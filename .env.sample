# ==============================================================================
# Homelab TCP Dual-Protocol - Configurações Gerais de Homologação / Desenvolvimento
# ==============================================================================
# Este arquivo consolida as configurações de servidor e cliente em um único local.

# Servidor
HOMELAB_SERVER_HOST=0.0.0.0
HOMELAB_CONTROL_PORT=9000
HOMELAB_DATA_PORT=9001
HOMELAB_DB_PATH=app/data/homelab.db
HOMELAB_LOG_PATH=app/logs/server_messages.log
HOMELAB_UPLOADS_DIR=app/data/uploads

# Cliente
HOMELAB_CLIENT_TARGET_HOST=127.0.0.1
HOMELAB_CLIENT_TIMEOUT=10.0
HOMELAB_CLIENT_BUFFER_SIZE=4096
HOMELAB_SESSION_PATH=app/data/client_session.json

# Segurança & Protocolo (compartilhado)
HOMELAB_HANDSHAKE_KEY=homelab-initial-handshake-key-32
HOMELAB_CHUNK_SIZE=65536
HOMELAB_BUFFER_SIZE=4096
