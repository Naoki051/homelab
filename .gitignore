# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Logs
*.log
app/logs/*.log
!app/logs/.gitkeep

# Virtual Environments
.venv/
venv/
env/

# Databases & Local Client Session Storage
*.db
*.sqlite3
app/data/*.db
app/data/*.sqlite3
app/data/*.json
!app/data/.gitkeep

# Environment variables and secrets
*.env
.env
.env.*
server.env
client.env
envs/*.env
envs/.env
envs/.env.*
envs/server.env
envs/client.env
!*.sample
!*.env.sample
!envs/*.sample
!envs/*.env.sample

# Operating System Files
.DS_Store
Thumbs.db
