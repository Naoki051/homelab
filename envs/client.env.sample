# ==============================================================================
# Homelab TCP Dual-Protocol - Configurações do CLIENTE
# ==============================================================================
# Este arquivo contém as variáveis exclusivas para a máquina do Cliente.

# Endereço IP do servidor remoto Homelab
HOMELAB_CLIENT_TARGET_HOST=192.168.0.246

# Portas dos canais de controle e dados do servidor
HOMELAB_CONTROL_PORT=9000
HOMELAB_DATA_PORT=9001

# Chave secreta inicial para handshake e autenticação prévia (deve coincidir com o servidor)
HOMELAB_HANDSHAKE_KEY=homelab-initial-handshake-key-32

# Tamanho padrão do buffer e chunks de mídia em bytes
HOMELAB_CHUNK_SIZE=65536
HOMELAB_CLIENT_BUFFER_SIZE=4096

# Tempo limite de timeout das operações de socket em segundos
HOMELAB_CLIENT_TIMEOUT=10.0

# Caminho local do arquivo de sessão NoSQL (JSON) para Quick Login
HOMELAB_SESSION_PATH=app/data/client_session.json
